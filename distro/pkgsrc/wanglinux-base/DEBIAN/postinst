#!/bin/sh
set -e
case "$1" in
  configure)
    for f in /etc/os-release /usr/lib/os-release; do
      if [ -e "$f" ] && ! dpkg-divert --list "$f" 2>/dev/null | grep -q wanglinux-base; then
        dpkg-divert --package wanglinux-base --divert "$f.debian" --rename "$f" >/dev/null
      fi
      ln -sf /usr/share/wanglinux/os-release "$f"
    done
    cat /usr/share/wanglinux/motd > /etc/motd 2>/dev/null || true
    ;;
esac
exit 0
