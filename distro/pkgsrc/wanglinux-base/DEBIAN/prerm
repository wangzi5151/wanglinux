#!/bin/sh
set -e
case "$1" in
  remove|deconfigure)
    for f in /etc/os-release /usr/lib/os-release; do
      if dpkg-divert --list "$f" 2>/dev/null | grep -q wanglinux-base; then
        rm -f "$f"
        dpkg-divert --package wanglinux-base --rename --remove "$f" >/dev/null
      fi
    done
    ;;
esac
exit 0
