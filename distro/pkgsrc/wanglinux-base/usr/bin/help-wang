#!/bin/sh
cat <<'TXT'
WangLinux 1.0 (Aurora) - quick help
  wanginfo                                 system information
  wanglinux-version                        version and repositories
  sudo apt update                          refresh package lists
  sudo apt install wanglinux-desktop       install the full desktop (Xfce)
  sudo apt full-upgrade                    upgrade to the latest release
  sudo raspi-config                        Raspberry Pi configuration
Notes
  * Chinese text needs a graphical terminal; the Linux text console is ASCII only.
  * Default login: user "wang" / password "wanglinux" (change it with passwd).
TXT
