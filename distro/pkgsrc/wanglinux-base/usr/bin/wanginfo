#!/bin/sh
# wanginfo - WangLinux system information (ASCII-only for VT console)
hf() { printf '%-10s %s\n' "$1" "$2"; }
REL=$(sed -n 's/^PRETTY_NAME="\(.*\)"/\1/p' /etc/os-release 2>/dev/null)
[ -n "$REL" ] || REL="WangLinux (unknown)"
PKGS=$(dpkg-query -f '.\n' -W 2>/dev/null | wc -l)
KERN=$(uname -r); KNOTE=""
case "$KERN" in
  *wanglinux*) : ;;
  *android*)   KNOTE=" [host kernel / chroot]" ;;
esac
hf "OS"       "$REL"
hf "Base"     "Debian $(cat /etc/debian_version 2>/dev/null) / $(uname -m)"
hf "Kernel"   "$KERN$KNOTE"
hf "Packages" "$PKGS installed"
hf "CPU"      "$(uname -m) x $(nproc 2>/dev/null || echo 1)"
hf "Memory"   "$(awk '/MemTotal/{printf "%.0f MB", $2/1024}' /proc/meminfo 2>/dev/null)"
hf "User"     "$(id -un) (uid=$(id -u))"
hf "Shell"    "${SHELL:-/bin/bash}"
hf "Uptime"   "$(uptime -p 2>/dev/null | sed 's/^up //')"
hf "Desktop"  "$(dpkg-query -W -f='${Status}' wanglinux-desktop 2>/dev/null | grep -q installed && echo 'installed' || echo 'not installed (apt install wanglinux-desktop)')"
