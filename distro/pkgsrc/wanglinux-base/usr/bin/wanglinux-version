#!/bin/sh
# wanglinux-version - 版本、仓库与升级信息
R=/usr/share/wanglinux/release
[ -r "$R" ] && . "$R"
echo "WangLinux ${WANGLINUX_VERSION:-?} (${WANGLINUX_CODENAME:-?})"
echo "  基础       : ${WANGLINUX_BASE:-Debian 12 (bookworm)}"
echo "  软件源套件 : ${WANGLINUX_SUITE:-aurora}"
echo "  软件源地址 : ${WANGLINUX_REPO:-?}"
echo -n "  base 包版本: "; dpkg-query -W -f='${Version}\n' wanglinux-base 2>/dev/null || echo "未安装"
echo -n "  desktop 元包: "; dpkg-query -W -f='${Status}\n' wanglinux-desktop 2>/dev/null || echo "未安装"
if command -v apt-get >/dev/null; then
  echo "  仓库可达性 : $(apt-get -s update >/dev/null 2>&1 && echo 正常 || echo 需 sudo 或网络)"
fi
