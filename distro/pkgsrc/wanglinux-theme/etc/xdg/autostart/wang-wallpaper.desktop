[Desktop Entry]
Type=Application
Name=WangLinux Wallpaper
Comment=Apply the Aurora wallpaper on login
Exec=sh -c 'W=/usr/share/wallpapers/wanglinux/aurora.png; for p in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep last-image); do xfconf-query -c xfce4-desktop -p "$p" -s "$W"; done'
OnlyShowIn=XFCE;
NoDisplay=true
